{
  "name": "pix-inter-api",
  "version": "1.0.0",
  "description": "API para gerar PIX com Banco Inter",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "tsc && node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node -e \"require('./dist/shared/migrations').runMigrations(process.env.DATABASE_URL).then(a=>console.log(a))\""
  },
  "dependencies": {
    "axios": "^1.4.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "node-cron": "^4.2.1",
    "pg": "^8.23.0",
    "uuid": "^9.0.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
